    "type": "streamable-http",
    "endpoint": "https://acme-guides.example/mcp"
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "authentication": {
    "required": false,
    "schemes": []
  },
  "tools": [
    {
      "name": "list_guides",
      "description": "List every guide with its slug and summary."
