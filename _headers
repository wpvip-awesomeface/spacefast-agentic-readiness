# Homepage Link header (RFC 8288). functions/home.js copies Link from /index.html, so both
# the "/" and "/index.html" blocks carry it.
/
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </api/openapi.json>; rel="service-desc"; type="application/vnd.oai.openapi+json"
  Link: </docs/api>; rel="service-doc"; type="text/markdown"
  Link: </index.md>; rel="alternate"; type="text/markdown"
  Link: </.well-known/ai-catalog.json>; rel="describedby"; type="application/json"
  Link: </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"

/index.html
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </api/openapi.json>; rel="service-desc"; type="application/vnd.oai.openapi+json"
  Link: </docs/api>; rel="service-doc"; type="text/markdown"
  Link: </index.md>; rel="alternate"; type="text/markdown"
  Link: </.well-known/ai-catalog.json>; rel="describedby"; type="application/json"
  Link: </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"

/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/index.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/docs/api
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/api
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  RateLimit-Policy: "burst";q=20;w=1
  X-RateLimit-Limit: 20
  API-Version: v1

/api/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  RateLimit-Policy: "burst";q=20;w=1
  X-RateLimit-Limit: 20
  API-Version: v1

/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *

/.well-known/ai-catalog.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/*
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/acme-guides/SKILL.md
  Content-Type: text/markdown; charset=utf-8

/.well-known/mcp/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/jwks.json
  Content-Type: application/jwk-set+json; charset=utf-8
  Access-Control-Allow-Origin: *

# Source copies and repo files are public on a Space but shouldn't be indexed.
/raw/*
  X-Robots-Tag: noindex

/tests/*
  X-Robots-Tag: noindex

/scripts/*
  X-Robots-Tag: noindex
